<Window x:Class="CoordinatesAudit.Views.AuditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Revit Coordinate Auditor" Height="720" Width="1260"
        MinHeight="560" MinWidth="980" WindowStartupLocation="CenterOwner"
        Background="#F4F6F8" FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#E8EDF2"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="180"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Coordinate Audit" FontSize="24" FontWeight="SemiBold" Foreground="#172B4D"/>
            <TextBlock x:Name="ProjectSummaryText" Foreground="#5E6C84" Margin="0,4,0,0"/>
            <TextBlock Text="Shared Coordinates mode: PBP and Internal Origin differences are informational; shared position, elevation, rotation, scale, and mirroring control PASS/FAIL."
                       Foreground="#5E6C84" Margin="0,3,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1" Background="White" BorderBrush="#D9E0E7" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Reference" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox Grid.Column="1" x:Name="ReferenceComboBox" DisplayMemberPath="DisplayName" SelectedValuePath="Id"/>
                <TextBlock Grid.Column="2" Text="Horizontal (mm)" VerticalAlignment="Center" Margin="16,0,8,0"/>
                <TextBox Grid.Column="3" x:Name="HorizontalToleranceTextBox" Text="1" VerticalContentAlignment="Center"/>
                <TextBlock Grid.Column="4" Text="Vertical (mm)" VerticalAlignment="Center" Margin="16,0,8,0"/>
                <TextBox Grid.Column="5" x:Name="VerticalToleranceTextBox" Text="1" VerticalContentAlignment="Center"/>
                <TextBlock Grid.Column="6" Text="Rotation (°)" VerticalAlignment="Center" Margin="16,0,8,0"/>
                <TextBox Grid.Column="7" x:Name="AngularToleranceTextBox" Text="0.001" VerticalContentAlignment="Center"/>
                <StackPanel Grid.Column="9" Orientation="Horizontal">
                    <Button Content="Run Comparison" Click="RunComparison_Click" Background="#0B6EBD" Foreground="White" BorderThickness="0"/>
                    <Button Content="Export CSV" Click="ExportCsv_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <DataGrid Grid.Row="2" x:Name="ResultsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" SelectionMode="Single" SelectionChanged="ResultsGrid_SelectionChanged"
                  GridLinesVisibility="Horizontal" AlternatingRowBackground="#F8FAFC" Background="White">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Status}" Value="PASS"><Setter Property="Background" Value="#E3FCEF"/></DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="WARNING"><Setter Property="Background" Value="#FFF7D6"/></DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="FAIL"><Setter Property="Background" Value="#FFEBE6"/></DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="UNAVAILABLE"><Setter Property="Background" Value="#EBECF0"/></DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="95"/>
                <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="220"/>
                <DataGridTextColumn Header="Instance" Binding="{Binding Instance}" Width="220"/>
                <DataGridTextColumn Header="Loaded" Binding="{Binding Loaded}" Width="70"/>
                <DataGridTextColumn Header="Internal Origin Δ" Binding="{Binding InternalDelta}" Width="150"/>
                <DataGridTextColumn Header="PBP Δ" Binding="{Binding ProjectBaseDelta}" Width="150"/>
                <DataGridTextColumn Header="Survey Δ" Binding="{Binding SurveyDelta}" Width="150"/>
                <DataGridTextColumn Header="Rotation Δ" Binding="{Binding RotationDelta}" Width="95"/>
                <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*" MinWidth="260"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" Background="White" BorderBrush="#D9E0E7" BorderThickness="1" Margin="0,12,0,12" Padding="10">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Text="Selected Link Details" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBox Grid.Row="1" x:Name="DetailsTextBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent"/>
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <TextBlock x:Name="StatusSummaryText" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <Button Content="Close" HorizontalAlignment="Right" MinWidth="90" Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>
